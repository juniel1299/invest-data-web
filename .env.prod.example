# 배포용 설정. 서버에서: cp .env.prod.example .env.prod 후 값을 채우세요 (.env.prod는 git에 올리지 않습니다)
# 긴 무작위 문자열: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
POSTGRES_PASSWORD=

# 사이트 주소. 오라클 서버면 도메인(예: invest.1-2-3-4.sslip.io), Tailscale Funnel이면 :80
SITE_ADDRESS=
# 브라우저에서 여는 주소 (https://...). 아래 세 값은 같은 주소를 기준으로 맞춥니다
APP_URL=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

SEC_USER_AGENT=invest-data-web your-email@example.com
PRICE_PROVIDER=stooq
TIINGO_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
NTFY_SERVER=https://ntfy.sh
OPENFIGI_API_KEY=
EMAIL_URL=
DEFAULT_FROM_EMAIL=
