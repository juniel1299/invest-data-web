# 이 파일을 .env 로 복사한 뒤 값을 채우세요: cp .env.example .env
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# SEC는 요청마다 이름과 이메일이 담긴 User-Agent를 요구합니다
SEC_USER_AGENT=invest-data-web your-email@example.com
# 종가 출처: stooq(기본, 키 불필요) 또는 tiingo(무료 키 필요)
PRICE_PROVIDER=stooq
TIINGO_API_KEY=
# 실적 발표일 (무료 키: https://finnhub.io/register). 비워두면 실적 일정만 건너뜁니다
FINNHUB_API_KEY=
# 배당 (무료 키, 하루 25회: https://www.alphavantage.co/support/#api-key). 비워두면 배당 일정만 건너뜁니다
ALPHA_VANTAGE_API_KEY=
# 푸시 알림 서버 (ntfy, 무료). 기본값은 공개 서버 https://ntfy.sh
NTFY_SERVER=https://ntfy.sh
# 13F의 CUSIP을 티커로 바꾸는 OpenFIGI 무료 키 (선택, https://www.openfigi.com/api)
OPENFIGI_API_KEY=
